# --- Server ---
PORT=4000
# Comma-separated list of web origins allowed to call this API (native apps don't send Origin, so they're unaffected)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- JWT ---
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string

# --- Firebase (service account) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
# Paste the private key with literal \n for newlines (the app converts them at boot)
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URL=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# --- Email (Resend) ---
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=
# Must be a verified sending domain/address in your Resend account
EMAIL_FROM="Elite Scope <noreply@yourdomain.com>"
EMAIL_BRAND_NAME=Elite Scope
# Publicly-hosted logo URL shown in emails (e.g. from your marketing site or a CDN).
# Most email clients block remote images by default and can't load a locally-bundled
# app asset, so leave this blank to fall back to a clean text/CSS wordmark instead.
EMAIL_LOGO_URL=
# Deep link / website the "Open Elite Scope" button in the welcome email points to
APP_URL=https://elitescope.app
SUPPORT_EMAIL=support@elitescope.app

# --- OTP ---
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60

# --- RevenueCat ---
# Secret key from RevenueCat → Project Settings → API Keys. SERVER-ONLY — never send this
# to the client app. If this value has ever been pasted anywhere outside a secrets manager
# (chat, a public repo, etc.), rotate it in RevenueCat before using it in production.
REVENUECAT_SECRET_KEY=
# The exact Authorization header value you configured on the RevenueCat webhook (Project
# Settings → Integrations → Webhooks). The backend checks incoming webhook requests against
# this to make sure they actually came from RevenueCat.
REVENUECAT_WEBHOOK_SECRET=
